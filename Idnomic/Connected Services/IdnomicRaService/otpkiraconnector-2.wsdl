  <wsdl:types>
    <wsdl:documentation>Types used by the OpenTrust-PKI SOAP Connector</wsdl:documentation>
    <xs:schema elementFormDefault="qualified" targetNamespace="http://www.opentrust.com/OpenTrust/XML/Message/1.2">
      <xs:include schemaLocation="otmessage-1.2.xsd" />
      <xs:annotation>
        <xs:documentation> External definition of the OpenTrust Message schema (version 1.2)</xs:documentation>
      </xs:annotation>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="OTMessageIn">
    <wsdl:documentation>Input message used for every OpenTrust PKI RA Connector operation : contains one
            argument : an OTMessage </wsdl:documentation>
    <wsdl:part name="InputParameter" type="otmsg:OTMessageType" />
  </wsdl:message>
  <wsdl:message name="OTMessageOut">
    <wsdl:documentation>Output message used for every OpenTrust PKI RA Connector operation : contains one
            argument : an OTMessage</wsdl:documentation>
    <wsdl:part name="OutputParameter" type="otmsg:OTMessageType" />
  </wsdl:message>
  <wsdl:portType name="OTPKIRAConnectorSOAPPortType">
    <wsdl:operation name="version">
      <wsdl:documentation> Returns Version Information about the PKI software and the RA connector</wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="enroll">
      <wsdl:documentation> Generates a new certificate </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="list_profiles">
      <wsdl:documentation> Returns the list of available certificate profiles </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="profile_properties">
      <wsdl:documentation> Returns information about the certificate profile given as argument. </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="revoke">
      <wsdl:documentation> Revokes a certificate </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="recover">
      <wsdl:documentation> Recovers a certificate </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="renew">
      <wsdl:documentation> Renews a certificate </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="hold">
      <wsdl:documentation>Puts a certificate on hold (currently does nothing)</wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="resume">
      <wsdl:documentation> Reactivates a certificate after a hold operation (currently does nothing) </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="retrieve_cert_authorities">
      <wsdl:documentation> Returns information on trusted
          certificate authorities : CRL, certificate, etc..
          </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="certificate_search_properties">
      <wsdl:documentation> Returns information on how to perform a
            search with the search_for_certificates operation :
            available criteria, profiles, etc..
          </wsdl:documentation>
      <wsdl:input message="pkiraconn:OTMessageIn" />
      <wsdl:output message="pkiraconn:OTMessageOut" />
    </wsdl:operation>
    <wsdl:operation name="search_for_certificates">
      <wsdl:documentation> Multi-criteria search operation used to
